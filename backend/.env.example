# Application Configuration
APP_NAME="FinPilot AI Backend"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Security & JWT Configuration
SECRET_KEY="change_this_to_a_secure_random_secret_key_in_production"
JWT_SECRET="change_this_to_a_secure_random_jwt_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER="FinPilot-AI"
JWT_AUDIENCE="FinPilot-Client"

# Account Security Policy
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="finpilot_db"
# DATABASE_URL="postgresql://postgres:postgres_password@localhost:5432/finpilot_db"

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]
